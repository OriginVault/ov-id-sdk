# OV-ID-SDK Security Configuration Template
# Copy this file to .env and configure the values for your environment

# =============================================================================
# CRITICAL SECURITY CONFIGURATION
# =============================================================================

# Master encryption key for envelope encryption (REQUIRED)
# Generate a secure 32-byte hex key: openssl rand -hex 32
# This key encrypts all data encryption keys (DEKs)
OV_MASTER_ENCRYPTION_KEY=your-32-byte-hex-key-here

# =============================================================================
# SECURITY FEATURES CONFIGURATION
# =============================================================================

# Enable envelope encryption (recommended: true)
OV_ENABLE_ENVELOPE_ENCRYPTION=true

# Enable memory protection (recommended: true)
OV_ENABLE_MEMORY_PROTECTION=true

# Enable key rotation (recommended: true)
OV_KEY_ROTATION_ENABLED=true

# Enable security monitoring (recommended: true)
OV_ENABLE_SECURITY_MONITORING=true

# Security log level (debug, info, warn, error)
OV_SECURITY_LOG_LEVEL=info

# =============================================================================
# CHEQD STUDIO INTEGRATION
# =============================================================================

# Cheqd Studio endpoint for cross-repo security coordination
OV_CHEQD_STUDIO_ENDPOINT=https://your-cheqd-studio.com

# Shared secret for secure communication with cheqd-studio
OV_CHEQD_STUDIO_SECRET=your-shared-secret-here

# Enable cross-repository synchronization
OV_ENABLE_CROSS_REPO_SYNC=true

# =============================================================================
# KEY ROTATION CONFIGURATION
# =============================================================================

# Automatic key rotation interval (in days)
OV_KEY_ROTATION_INTERVAL_DAYS=90

# Emergency key rotation threshold (in days)
OV_EMERGENCY_ROTATION_THRESHOLD_DAYS=7

# =============================================================================
# MEMORY PROTECTION CONFIGURATION
# =============================================================================

# Memory cleanup interval (in minutes)
OV_MEMORY_CLEANUP_INTERVAL_MINUTES=5

# Maximum number of sensitive buffers to track
OV_MAX_SENSITIVE_BUFFERS=1000

# =============================================================================
# ENCRYPTION CONFIGURATION
# =============================================================================

# Default encryption algorithm
OV_DEFAULT_ENCRYPTION_ALGORITHM=aes-256-gcm

# Key derivation function iterations
OV_SCRYPT_ITERATIONS=16384

# =============================================================================
# SECURITY VALIDATION CONFIGURATION
# =============================================================================

# Enable automatic security validation on startup
OV_ENABLE_STARTUP_SECURITY_VALIDATION=true

# Security validation interval (in hours)
OV_SECURITY_VALIDATION_INTERVAL_HOURS=24

# Minimum security score threshold (0-100)
OV_MIN_SECURITY_SCORE=80

# =============================================================================
# LEGACY COMPATIBILITY
# =============================================================================

# Legacy encryption key (DEPRECATED - use OV_MASTER_ENCRYPTION_KEY instead)
# This is kept for backward compatibility during migration
ENCRYPTION_KEY=legacy-encryption-key

# =============================================================================
# DEVELOPMENT/TESTING CONFIGURATION
# =============================================================================

# Enable development mode (disables some security features)
OV_DEVELOPMENT_MODE=false

# Enable test mode (uses weaker encryption for testing)
OV_TEST_MODE=false

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Enable detailed security logging
OV_ENABLE_DETAILED_SECURITY_LOGS=true

# Log security events to file
OV_LOG_SECURITY_EVENTS_TO_FILE=true

# Security log file path
OV_SECURITY_LOG_FILE=./logs/security.log

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================

# Maximum encryption operations per second
OV_MAX_ENCRYPTION_OPS_PER_SECOND=1000

# Encryption operation timeout (in milliseconds)
OV_ENCRYPTION_TIMEOUT_MS=5000

# =============================================================================
# BACKUP AND RECOVERY
# =============================================================================

# Enable automatic backup of security keys
OV_ENABLE_AUTOMATIC_BACKUP=true

# Backup interval (in hours)
OV_BACKUP_INTERVAL_HOURS=24

# Maximum number of backups to keep
OV_MAX_BACKUPS_TO_KEEP=30

# Backup storage location
OV_BACKUP_STORAGE_PATH=./backups/security

# =============================================================================
# COMPLIANCE AND AUDITING
# =============================================================================

# Enable audit logging
OV_ENABLE_AUDIT_LOGGING=true

# Audit log retention period (in days)
OV_AUDIT_LOG_RETENTION_DAYS=365

# Enable compliance reporting
OV_ENABLE_COMPLIANCE_REPORTING=true

# =============================================================================
# NETWORK SECURITY
# =============================================================================

# Enable TLS for all external communications
OV_ENABLE_TLS=true

# TLS certificate validation
OV_VALIDATE_TLS_CERTIFICATES=true

# Connection timeout (in seconds)
OV_CONNECTION_TIMEOUT_SECONDS=30

# Maximum retry attempts for failed operations
OV_MAX_RETRY_ATTEMPTS=3

# =============================================================================
# RATE LIMITING
# =============================================================================

# Enable rate limiting for security operations
OV_ENABLE_RATE_LIMITING=true

# Maximum requests per minute
OV_MAX_REQUESTS_PER_MINUTE=100

# Rate limiting window (in minutes)
OV_RATE_LIMITING_WINDOW_MINUTES=1
