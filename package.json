{
  "name": "@originvault/ov-id-sdk",
  "did": "did:cheqd:mainnet:a11f08bc-568c-5ecd-b5c8-7ff15c9d3892",
  "testDid": "did:cheqd:testnet:d6f329f4-d1fd-527b-9708-0fc3ed01f960",
  "version": "0.0.18-alpha.21",
  "organization": "originvault",
  "description": "A TypeScript SDK for managing decentralized identities (DIDs) and verifiable credentials (VCs)",
  "main": "./dist/index.js",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./dist/src/*": "./dist/src/*"
  },
  "files": [
    "dist/**/*",
    "package.json"
  ],
  "scripts": {
    "build": "npm run clean && cross-env NODE_OPTIONS=--max-old-space-size=8192 tsc --project tsconfig.build.json --noEmitOnError false",
    "tsc": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsc --project tsconfig.build.json",
    "clean": "rimraf dist",
    "cm": "cz",
    "lint": "eslint ./src/ --fix",
    "test": "jest --coverage",
    "test:all": "node scripts/run-tests.js --all",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:performance": "jest --testPathPattern=performance",
    "test:security": "jest --testPathPattern=security",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:debug": "jest --detectOpenHandles --forceExit --verbose",
    "test:coverage": "jest --coverage --coverageReporters=text-lcov | coveralls",
    "test:runner": "node scripts/run-tests.js",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "prestart": "node scripts/prestart.ts",
    "sign-release": "npx tsx scripts/sign-release-metadata.js",
    "get-mnemonic": "npx tsx scripts/get-mnemonic.js",
    "resolve-did": "npx tsx scripts/resolve-did.js",
    "create-did": "npx tsx scripts/create-did.js",
    "generate-didcomm-keys": "npx tsx scripts/generate-didcomm-keys.ts",
    "generate-encryption-keys": "node scripts/generate-encryption-keys.js",
    "create-verida-did": "npx tsx scripts/create-verida-did.js",
    "import-did": "npx tsx scripts/import-did.js",
    "create-did-linked-executable": "npx tsx scripts/create-did-linked-executable.js",
    "pre-publish": "npm run build && npm run sign-release",
    "send-message": "npx tsx scripts/send-message.js",
    "add-key-agreement": "npx tsx scripts/add-key-agreement.js",
    "sign-verifiable-credential": "npx tsx scripts/sign-verifiable-credential.js",
    "get-key-from-mnemonic": "npx tsx scripts/get-key-from-mnemonic.js",
    "test-message-signing": "npx tsx scripts/test-message-signing.js",
    "test-session-did": "npx tsx scripts/test-session-did.js",
    "test-didcomm-integration": "npx tsx scripts/test-didcomm-integration.js",
    "setup-security": "node scripts/setup-security.js",
    "example:cheqd-integration": "npx tsx examples/cheqd-studio-integration-example.ts",
    "vitest": "vitest run --coverage",
    "vitest:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OriginVault/ov-id-sdk.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0"
  },
  "keywords": [
    "DID",
    "well-known"
  ],
  "homepage": "https://www.originvault.box",
  "dependencies": {
    "@cheqd/did-provider-cheqd": "^4.1.1",
    "@cosmjs/proto-signing": "^0.33.0",
    "@cosmjs/tendermint-rpc": "^0.33.1",
    "@ipld/dag-pb": "^4.1.5",
    "@multiformats/base-x": "^4.0.1",
    "@noble/ed25519": "^2.2.3",
    "@noble/hashes": "^1.7.1",
    "@polkadot/api": "^15.8.1",
    "@polkadot/keyring": "^13.4.3",
    "@polkadot/util": "^13.4.3",
    "@polkadot/util-crypto": "^13.4.3",
    "@scure/bip39": "^1.5.4",
    "@tgwf/co2": "^0.16.6",
    "@veramo/core": "^6.0.0",
    "@veramo/core-types": "^6.0.0",
    "@veramo/credential-w3c": "^6.0.0",
    "@veramo/data-store": "^6.0.0",
    "@veramo/did-comm": "^6.0.0",
    "@veramo/did-provider-peer": "^6.0.0",
    "@veramo/did-resolver": "^6.0.0",
    "@veramo/kms-local": "^6.0.0",
    "@veramo/message-handler": "^6.0.0",
    "@veramo/remote-server": "^6.0.0",
    "bip39": "^3.1.0",
    "crystals-kyber-js": "^1.0.0",
    "ignore": "^7.0.3",
    "inquirer": "^12.5.0",
    "libsodium-wrappers": "^0.7.13",
    "multiformats": "^13.3.2",
    "node-fetch": "^3.3.2",
    "ora": "^8.2.0",
    "read-package-json-fast": "^4.0.0",
    "tar-stream": "^3.1.7",
    "typeorm": "^0.3.20",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-typescript": "^7.27.1",
    "@originvault/ov-types": "^0.0.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.13",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "babel-jest": "^30.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^ 10.1.1",
    "eslint-plugin-prettier": "^5.2.5",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "semantic-release": "^24.2.3",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.2.1",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.28.0",
    "vitest": "^2.1.3"
  },
  "lint-staged": {
    "*.ts": "eslint --cache --cache-location .eslintcache --fix"
  },
  "resolutions": {
    "@ethersproject/providers": "5.8.1"
  },
  "directories": {
    "doc": "docs",
    "example": "examples"
  },
  "author": "",
  "bugs": {
    "url": "https://github.com/OriginVault/ov-id-sdk/issues"
  }
}
